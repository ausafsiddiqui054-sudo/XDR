<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>securepulse-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecurePulse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.*" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecurePulse.Core\SecurePulse.Core.csproj" />
    <ProjectReference Include="..\SecurePulse.Data\SecurePulse.Data.csproj" />
    <ProjectReference Include="..\SecurePulse.Reporting\SecurePulse.Reporting.csproj" />
  </ItemGroup>

</Project>
