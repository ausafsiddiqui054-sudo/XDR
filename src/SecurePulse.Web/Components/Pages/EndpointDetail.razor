@page "/endpoints/{TenantId:guid}/{DeviceId}"
@inject EndpointService EndpointData
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IUserContextAccessor Current
@inject DeviceActionRequestService Actions

<PageTitle>@(_detail?.Device.DeviceName ?? "Device") · SecurePulse</PageTitle>

@if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_detail is null)
{
    <MudPaper Class="sp-card pa-8" Elevation="0" Outlined="true">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <span class="sp-icon-badge sp-icon-badge-lg"><MudIcon Icon="@Icons.Material.Rounded.DevicesOther" Size="Size.Large" /></span>
            <MudText Typo="Typo.h6">Device not found</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">It may have been removed from Intune since the last inventory.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="endpoints" StartIcon="@Icons.Material.Rounded.ArrowBack">Back to endpoints</MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    var d = _detail.Device;
    var tenant = _detail.Tenant;
    var failing = d.ComplianceSettings.Where(s => !s.Compliant).ToList();
    var stale = d.LastSyncAt is not { } last || DateTimeOffset.UtcNow - last > EndpointService.StaleAfter;

    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6" Wrap="Wrap.Wrap" Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
            <span class="sp-icon-badge sp-icon-badge-lg"><MudIcon Icon="@SecurePulseTheme.IconOf(d.Platform)" Size="Size.Large" /></span>
            <div style="min-width:0">
                <MudText Typo="Typo.h4">@d.DeviceName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@d.Manufacturer @d.Model · @tenant.DisplayName</MudText>
                <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                    <ComplianceChip State="d.ComplianceState" />
                    <DefenderChip State="d.Defender" />
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@d.Ownership</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@SecurePulseTheme.Label(d.Platform)</MudChip>
                </MudStack>
            </div>
        </MudStack>

        @* Client viewers are read-only: no remote actions at all. *@
        @if (_isOperator)
        {
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@DeviceActions.Icon(DeviceAction.Sync)"
                       Disabled="!CanRequest" OnClick="@(() => RequestAsync(DeviceAction.Sync))">Sync</MudButton>
            <MudMenu Label="More actions" EndIcon="@Icons.Material.Rounded.KeyboardArrowDown" Variant="Variant.Outlined"
                     Color="Color.Primary" Disabled="!CanRequest" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var action in new[] { DeviceAction.Restart, DeviceAction.DefenderQuickScan, DeviceAction.DefenderUpdateSignatures,
                                                DeviceAction.Retire, DeviceAction.Wipe }.Where(a => DeviceActionPolicy.AppliesTo(a, d.Platform)))
                {
                    <MudMenuItem Icon="@DeviceActions.Icon(action)"
                                 IconColor="@(DeviceActions.IsDestructive(action) ? Color.Error : Color.Default)"
                                 OnClick="@(() => RequestAsync(action))">@DeviceActions.Label(action)</MudMenuItem>
                }
            </MudMenu>
        </MudStack>
        }
    </MudStack>

    @if (_isOperator && !CanRemediate)
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Class="mb-4" Style="border-radius:16px"
                  Icon="@Icons.Material.Rounded.Lock">
            SecurePulse has read-only access to @tenant.DisplayName. Remote actions need remediation consent from the
            tenant's admin, and each one then goes through approval.
        </MudAlert>
    }
    else if (OpenAction is { } open)
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Class="mb-4" Style="border-radius:16px" data-testid="open-action">
            @DeviceActions.Label(open.Action) requested by @open.RequestedByName is @DeviceActionRequestService.Label(open.Status).ToLowerInvariant().
            New actions can be requested once it's finished or cancelled.
        </MudAlert>
    }

    <MudGrid Spacing="4">
        <MudItem xs="12" md="7">
            <MudStack Spacing="4">
                <MudPaper Class="sp-card pa-5" Elevation="0" Outlined="true">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">Compliance</MudText>
                        <MudText Typo="Typo.body2" Color="@(failing.Count > 0 ? Color.Error : Color.Success)">
                            @(failing.Count == 0 ? "All settings pass" : $"{failing.Count} of {d.ComplianceSettings.Count} settings failing")
                        </MudText>
                    </MudStack>
                    @foreach (var policy in d.ComplianceSettings.GroupBy(s => s.Policy))
                    {
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@policy.Key</MudText>
                        <MudList T="string" Dense="true" ReadOnly="true" Padding="false">
                            @foreach (var s in policy.OrderBy(s => s.Compliant))
                            {
                                <MudListItem T="string"
                                             Icon="@(s.Compliant ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.Cancel)"
                                             IconColor="@(s.Compliant ? Color.Success : Color.Error)">
                                    <MudText Typo="Typo.body2" Style="@(s.Compliant ? "" : "font-weight:600")">@s.Setting</MudText>
                                    @if (s.Detail is { } detail)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@detail</MudText>
                                    }
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudPaper>

                <MudPaper Class="sp-card pa-5" Elevation="0" Outlined="true" data-testid="defender-card">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap" Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <span class="sp-icon-badge">
                                <MudIcon Icon="@SecurePulseTheme.IconOf(d.Defender)" Color="@SecurePulseTheme.ColorOf(d.Defender)" />
                            </span>
                            <div>
                                <MudText Typo="Typo.h6">Microsoft Defender</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@DefenderSummary(d)</MudText>
                            </div>
                        </MudStack>
                        <MudText Typo="Typo.body2" Style="font-weight:600" Color="@SecurePulseTheme.ColorOf(d.Defender)">@SecurePulseTheme.Label(d.Defender)</MudText>
                    </MudStack>

                    @if (d.DefenderDetails is not { } dh)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Defender health hasn't been read for this device yet. It appears after the Worker's next device sync.
                        </MudText>
                    }
                    else
                    {
                        @if (dh.Issues.Count > 0)
                        {
                            <MudList T="string" Dense="true" ReadOnly="true" Padding="false" Class="mb-3" data-testid="defender-issues">
                                @foreach (var issue in dh.Issues)
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Rounded.ErrorOutline"
                                                 IconColor="@(d.Defender == DefenderState.NotOnboarded ? Color.Warning : Color.Error)">
                                        <MudText Typo="Typo.body2" Style="font-weight:600">@issue</MudText>
                                    </MudListItem>
                                }
                            </MudList>
                        }

                        <MudGrid Spacing="4">
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">Antivirus</MudText>
                                @if (dh.Antivirus is { } av)
                                {
                                    <dl class="sp-props mt-1">
                                        <DefenderCheck Label="Antivirus" Value="av.MalwareProtectionEnabled" />
                                        <DefenderCheck Label="Real-time protection" Value="av.RealTimeProtectionEnabled" />
                                        <DefenderCheck Label="Tamper protection" Value="av.TamperProtectionEnabled" />
                                        <DefenderCheck Label="Security intelligence" Value="@(av.SignaturesOutOfDate is { } old ? !old : null)" On="Up to date" Off="Out of date" />
                                        <dt>Threats</dt>
                                        <dd><MudText Typo="Typo.body2" Color="@SecurePulseTheme.ColorOf(av.ThreatState)">@SecurePulseTheme.Label(av.ThreatState)</MudText></dd>
                                        <dt>Signatures</dt>
                                        <dd>@(av.SignatureVersion ?? "—")</dd>
                                        <dt>Engine</dt>
                                        <dd>@(av.EngineVersion ?? "—")</dd>
                                        <dt>Last quick scan</dt>
                                        <dd>@(av.LastQuickScanAt is { } qs ? Dashboard.Ago(qs) : "—")@(av.QuickScanOverdue == true ? " · overdue" : "")</dd>
                                        <dt>Reported</dt>
                                        <dd>@(av.LastReportedAt is { } rep ? Dashboard.Ago(rep) : "—")@(av.RebootRequired == true ? " · restart required" : "")</dd>
                                    </dl>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                        @(d.Platform == DevicePlatform.Windows
                                            ? "Intune hasn't reported Defender Antivirus state for this device yet."
                                            : "Intune reports Defender Antivirus state for Windows devices only.")
                                    </MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">Endpoint detection and response</MudText>
                                @if (!dh.SensorDataAvailable)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                        Not checked: Defender for Endpoint data for @tenant.DisplayName couldn't be read on the last sync.
                                    </MudText>
                                }
                                else if (dh.Sensor is not { } sensor)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                        Defender for Endpoint has no record of this device in the last 30 days.
                                    </MudText>
                                }
                                else
                                {
                                    <dl class="sp-props mt-1">
                                        <dt>Onboarding</dt>
                                        <dd>@SecurePulseTheme.Label(sensor.Onboarding)</dd>
                                        @if (sensor.Onboarding == DefenderOnboarding.Onboarded)
                                        {
                                            <dt>Sensor</dt>
                                            <dd><MudText Typo="Typo.body2" Color="@SecurePulseTheme.ColorOf(sensor.Health)">@SecurePulseTheme.Label(sensor.Health)</MudText></dd>
                                        }
                                        <dt>Exposure</dt>
                                        <dd>@(sensor.ExposureLevel ?? "Not assessed")</dd>
                                        <dt>Last seen</dt>
                                        <dd>@(sensor.LastSeenAt is { } seen ? Dashboard.Ago(seen) : "—")</dd>
                                        @if (sensor.MachineId is { } machine)
                                        {
                                            <dt>Defender ID</dt>
                                            <dd style="font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:0.75rem">@machine</dd>
                                        }
                                    </dl>
                                }
                            </MudItem>
                        </MudGrid>
                    }
                </MudPaper>

                <MudPaper Class="sp-card pa-5" Elevation="0" Outlined="true">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1" Wrap="Wrap.Wrap">
                        <div>
                            <MudText Typo="Typo.h6">Tenant device policies</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Open device findings for @tenant.DisplayName</MudText>
                        </div>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   Href="@($"findings?tenant={tenant.Id}")">View all findings</MudButton>
                    </MudStack>
                    @if (_detail.RelatedFindings.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No open device findings for this tenant.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1" Class="mt-2">
                            @foreach (var f in _detail.RelatedFindings)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="sp-breakdown-row">
                                    <div style="min-width:0">
                                        <MudText Typo="Typo.body2" Style="font-weight:600">@f.Title</MudText>
                                        @if (f.Evidence is { } ev)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ev</MudText>
                                        }
                                    </div>
                                    <MudStack Row="true" Spacing="1">
                                        <SeverityChip Severity="f.Severity" />
                                        <StatusChip Status="f.Status" />
                                    </MudStack>
                                </MudStack>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudStack Spacing="4">
                <MudPaper Class="sp-card pa-5" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-3">Protection</MudText>
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <span class="sp-icon-badge">
                                <MudIcon Icon="@(d.IsEncrypted == false ? Icons.Material.Rounded.LockOpen : Icons.Material.Rounded.Lock)"
                                         Color="@(d.IsEncrypted switch { true => Color.Success, false => Color.Error, _ => Color.Default })" />
                            </span>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:600">Disk encryption</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(d.IsEncrypted switch { true => "Encrypted", false => "Not encrypted", _ => "Not reported" })
                                </MudText>
                            </div>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <span class="sp-icon-badge">
                                <MudIcon Icon="@SecurePulseTheme.IconOf(d.Defender)" Color="@SecurePulseTheme.ColorOf(d.Defender)" />
                            </span>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:600">Microsoft Defender</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @SecurePulseTheme.Label(d.Defender)@(d.DefenderDetails?.Issues is { Count: > 0 } di ? $" · {di.Count} issue{(di.Count == 1 ? "" : "s")}" : "")
                                </MudText>
                            </div>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <span class="sp-icon-badge">
                                <MudIcon Icon="@Icons.Material.Rounded.Sync" Color="@(stale ? Color.Warning : Color.Success)" />
                            </span>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:600">Last check-in</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @Dashboard.Ago(d.LastSyncAt)@(stale ? " · compliance may be out of date" : "")
                                </MudText>
                            </div>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                @if (_history.Count > 0 || CanRemediate)
                {
                    <MudPaper Class="sp-card pa-5" Elevation="0" Outlined="true" data-testid="action-history">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.h6">Remote actions</MudText>
                            @if (_isOperator)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Href="devices/actions">All requests</MudButton>
                            }
                        </MudStack>
                        @if (_history.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">None requested yet.</MudText>
                        }
                        <MudStack Spacing="3">
                            @foreach (var v in _history)
                            {
                                var a = v.Request;
                                <div>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@DeviceActions.Icon(a.Action)" Size="Size.Small"
                                                     Color="@(DeviceActions.IsDestructive(a.Action) ? Color.Error : Color.Primary)" />
                                            <MudText Typo="Typo.body2" Style="font-weight:600">@DeviceActions.Label(a.Action)</MudText>
                                        </MudStack>
                                        <DeviceActionStatusChip Status="a.Status" />
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                        Requested by @a.RequestedByName @Dashboard.Ago(a.RequestedAt).ToLowerInvariant(): “@a.Reason”
                                    </MudText>
                                    @if (a.DecidedByName is { } decider)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                            @(a.Status == DeviceActionStatus.Rejected ? "Rejected" : "Approved") by @decider@(a.DecisionNote is { } n ? $": “{n}”" : "")
                                        </MudText>
                                    }
                                    @if (a.Error is { } err && a.Status is DeviceActionStatus.Failed or DeviceActionStatus.Expired or DeviceActionStatus.Cancelled)
                                    {
                                        <MudText Typo="Typo.caption" Color="@(a.Status == DeviceActionStatus.Failed ? Color.Error : Color.Secondary)"
                                                 Class="d-block" Style="overflow-wrap:anywhere">@err</MudText>
                                    }
                                    @if (v.CanCancel)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default" Class="px-0 mt-1"
                                                   OnClick="@(() => CancelAsync(a.Id))">Cancel request</MudButton>
                                    }
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                }

                <MudPaper Class="sp-card pa-5" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-3">Device</MudText>
                    <dl class="sp-props">
                        <dt>Primary user</dt>
                        <dd>@(d.UserDisplayName ?? "None")</dd>
                        <dt>User principal</dt>
                        <dd>@(d.UserPrincipalName ?? "—")</dd>
                        <dt>Ownership</dt>
                        <dd>@d.Ownership</dd>
                        <dt>Operating system</dt>
                        <dd>@(d.OsVersion ?? "—")</dd>
                        <dt>Manufacturer</dt>
                        <dd>@(d.Manufacturer ?? "—")</dd>
                        <dt>Model</dt>
                        <dd>@(d.Model ?? "—")</dd>
                        <dt>Serial number</dt>
                        <dd>@(d.SerialNumber ?? "—")</dd>
                        <dt>Enrolled</dt>
                        <dd>@(d.EnrolledAt?.ToLocalTime().ToString("d MMM yyyy") ?? "—")</dd>
                        <dt>Intune device ID</dt>
                        <dd style="font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:0.8rem">@d.Id</dd>
                    </dl>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public string DeviceId { get; set; } = "";

    private DeviceDetail? _detail;
    private bool _loaded;
    private List<BreadcrumbItem> _breadcrumbs = [];

    private bool _isOperator;

    private IReadOnlyList<DeviceActionView> _history = [];

    private bool CanRemediate => _isOperator && _detail?.Tenant.CanRemediate == true;

    private DeviceActionRequest? OpenAction => _history.Select(v => v.Request).FirstOrDefault(a => a.IsOpen);

    private bool CanRequest => CanRemediate && OpenAction is null;

    private static string DefenderSummary(ManagedDevice d) => d.DefenderDetails is null ? "No Defender data for this device yet." : d.Defender switch
    {
        DefenderState.Protected => "Antivirus and EDR sensor are healthy.",
        DefenderState.Unhealthy => "Defender is installed but not fully protecting this device.",
        DefenderState.NotOnboarded => "Not onboarded to Defender for Endpoint, so threats on it aren't detected or investigated.",
        _ => "No Defender data for this device."
    };

    protected override async Task OnParametersSetAsync()
    {
        _isOperator = (await Current.GetAsync()).IsOperator;
        _detail = await EndpointData.GetDeviceAsync(TenantId, DeviceId);
        _history = _detail is null ? [] : await Actions.GetForDeviceAsync(TenantId, _detail.Device.Id);
        _breadcrumbs =
        [
            new("Endpoints", href: "endpoints"),
            new(_detail?.Tenant.DisplayName ?? "Tenant", href: $"endpoints?tenant={TenantId}"),
            new(_detail?.Device.DeviceName ?? "Device", href: null, disabled: true)
        ];
        _loaded = true;
    }

    private async Task RequestAsync(DeviceAction action)
    {
        if (_detail is null || !CanRemediate) return;

        var parameters = new DialogParameters<RemoteActionDialog>
        {
            { x => x.Action, action },
            { x => x.DeviceName, _detail.Device.DeviceName },
            { x => x.TenantName, _detail.Tenant.DisplayName }
        };
        var dialog = await Dialogs.ShowAsync<RemoteActionDialog>(null, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        if ((await dialog.Result) is { Canceled: false, Data: string reason })
        {
            var outcome = await Actions.RequestAsync(_detail.Tenant.Id, _detail.Device.Id, action, reason);
            Snackbar.Add(outcome.Message, outcome.Ok ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning);
            _history = await Actions.GetForDeviceAsync(TenantId, _detail.Device.Id);
        }
    }

    private async Task CancelAsync(Guid id)
    {
        var outcome = await Actions.CancelAsync(id);
        Snackbar.Add(outcome.Message, outcome.Ok ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning);
        if (_detail is not null) _history = await Actions.GetForDeviceAsync(TenantId, _detail.Device.Id);
    }
}
