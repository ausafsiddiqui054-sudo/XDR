@page "/"
@inject PostureService Posture
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IUserContextAccessor Current
@inject ScanRequestService Scans
@inject SecurePulse.Web.Services.Onboarding.PortalMode Mode

<PageTitle>Overview · SecurePulse</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h4">Security posture</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_isViewer && _portfolio?.Tenants.FirstOrDefault() is { } own ? $"{own.Tenant.DisplayName} · Microsoft 365" : "Across all connected Microsoft 365 tenants")
        </MudText>
    </div>
    <AuthorizeView Policy="@Policies.Operator">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh"
                   OnClick="RunScan" Disabled="_queueing">Run scan</MudButton>
    </AuthorizeView>
    @if (_isViewer && _portfolio?.Scanned.FirstOrDefault() is { } mine)
    {
        <ReportButton TenantId="mine.Tenant.Id" Variant="Variant.Filled" />
    }
</MudStack>

@if (_portfolio is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="4">
            <MudPaper Class="sp-card pa-6" Elevation="0" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-4">@(_isViewer ? "Security score" : "Portfolio score")</MudText>
                <ScoreRing Score="_portfolio.AverageScore" Grade="@GradeOf(_portfolio.AverageScore)" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-4">
                    @(_isViewer ? "Updated after each scan" : $"Average of {_portfolio.Scanned.Count()} scanned tenants")
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudGrid Spacing="4">
                <MudItem xs="6" sm="6">
                    <Kpi Label="Open critical" Value="@_portfolio.OpenOf(Severity.Critical)" Icon="@Icons.Material.Rounded.ErrorOutline" Color="Color.Error" />
                </MudItem>
                <MudItem xs="6" sm="6">
                    <Kpi Label="Open high" Value="@_portfolio.OpenOf(Severity.High)" Icon="@Icons.Material.Rounded.WarningAmber" Color="Color.Warning" />
                </MudItem>
                <MudItem xs="6" sm="6">
                    <Kpi Label="Checks passing" Value="@_portfolio.PassRatePercent" Suffix="%" Icon="@Icons.Material.Rounded.CheckCircleOutline" Color="Color.Success" />
                </MudItem>
                <MudItem xs="6" sm="6">
                    <Kpi Label="Tenants connected" Value="@_portfolio.Tenants.Count" Icon="@Icons.Material.Rounded.Apartment" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12" lg="7">
            <MudPaper Class="sp-card pa-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="px-2 pb-2">Tenants</MudText>
                <MudTable Items="_portfolio.Tenants" T="TenantPosture" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm"
                          RowClass="sp-clickable-row" OnRowClick="@(e => OpenTenant(e.Item!))">
                    <HeaderContent>
                        <MudTh>Tenant</MudTh>
                        <MudTh>Score</MudTh>
                        <MudTh>Critical</MudTh>
                        <MudTh>Last scan</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tenant">
                            <MudText Typo="Typo.body1">@context.Tenant.DisplayName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.Tenant.PartnerName ?? "Direct client")</MudText>
                        </MudTd>
                        <MudTd DataLabel="Score">
                            @if (context.Score is { } s)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudProgressLinear Value="@s.Score" Color="@SecurePulseTheme.ColorOfScore(s.Score)" Rounded="true" Size="Size.Medium" Style="width:96px" />
                                    <MudText Typo="Typo.body2"><b>@s.Score</b> · @s.Grade</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Awaiting consent</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Critical">
                            @{ var crit = context.Score?.FailedBySeverity[Severity.Critical] ?? 0; }
                            <MudText Typo="Typo.body2" Color="@(crit > 0 ? Color.Error : Color.Default)">@crit</MudText>
                        </MudTd>
                        <MudTd DataLabel="Last scan">
                            <MudText Typo="Typo.body2">@Ago(context.Tenant.LastScanAt)</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Class="sp-card pa-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="px-2 pb-2">Fix these first</MudText>
                <MudStack Spacing="1">
                    @foreach (var (tenant, finding) in _portfolio.TopRisks())
                    {
                        <MudPaper Elevation="0" Class="pa-3 sp-clickable-row" Style="border-radius:16px"
                                  @onclick="@(() => Nav.NavigateTo($"findings?tenant={tenant.Tenant.Id}"))">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <div style="min-width:0">
                                    <MudText Typo="Typo.body2" Style="font-weight:600">@finding.Title</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@tenant.Tenant.DisplayName · @finding.Category</MudText>
                                </div>
                                <SeverityChip Severity="finding.Severity" />
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private PortfolioPosture? _portfolio;

    private bool _isViewer;

    protected override async Task OnInitializedAsync()
    {
        _isViewer = (await Current.GetAsync()).Role == PortalRole.ClientViewer;
        _portfolio = await Posture.GetPortfolioAsync();
    }

    private void OpenTenant(TenantPosture t) => Nav.NavigateTo($"findings?tenant={t.Tenant.Id}");

    private bool _queueing;

    private async Task RunScan()
    {
        if (_queueing) return;
        _queueing = true;
        try
        {
            var ready = _portfolio?.Tenants.Count(t => ScanRequestService.IsOnboarded(t.Tenant)) ?? 0;
            var queued = await Scans.RequestAllAsync();
            var (message, severity) = (queued, ready) switch
            {
                (_, 0) => ("No tenants are ready to scan yet: each needs consent and a certificate.", MudBlazor.Severity.Warning),
                (0, _) => ("Scans are already queued or running for every tenant.", MudBlazor.Severity.Info),
                _ => ($"Queued {queued} scan{(queued == 1 ? "" : "s")}. Results appear as each one finishes.", MudBlazor.Severity.Success)
            };
            if (queued > 0 && !Mode.UsesDatabase)
                message += " (Sample data mode: no Worker runs them.)";
            Snackbar.Add(message, severity);
        }
        finally
        {
            _queueing = false;
        }
    }

    private static string GradeOf(int score) => score switch { >= 90 => "A", >= 80 => "B", >= 70 => "C", >= 60 => "D", _ => "F" };

    internal static string Ago(DateTimeOffset? when)
    {
        if (when is null) return "Never";
        var span = DateTimeOffset.UtcNow - when.Value;
        return span.TotalMinutes < 1 ? "Just now"
            : span.TotalHours < 1 ? $"{(int)span.TotalMinutes}m ago"
            : span.TotalHours < 24 ? $"{(int)span.TotalHours}h ago"
            : $"{(int)span.TotalDays}d ago";
    }
}
