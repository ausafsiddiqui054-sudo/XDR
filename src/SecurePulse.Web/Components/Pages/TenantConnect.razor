@page "/tenants/connect"
@attribute [Authorize(Policy = Policies.Operator)]
@using SecurePulse.Web.Services.Onboarding
@inject OnboardingService Onboarding
@inject NavigationManager Nav

<PageTitle>Connect tenant · SecurePulse</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

<div class="mb-6">
    <MudText Typo="Typo.h4">Connect a tenant</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Create a consent link for the client's Microsoft 365 admin</MudText>
</div>

<MudGrid Spacing="4">
    <MudItem xs="12" md="7">
        <MudPaper Class="sp-card pa-6" Elevation="0" Outlined="true">
            @if (!Onboarding.IsConfigured)
            {
                <MudAlert Severity="MudBlazor.Severity.Warning" Variant="Variant.Outlined" Class="mb-4" Style="border-radius:16px">
                    Set <code>Onboarding:AppClientId</code> to the SecurePulse app registration's client ID to create consent links.
                </MudAlert>
            }
            @if (_error is not null)
            {
                <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Outlined" Class="mb-4" Style="border-radius:16px">@_error</MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="_valid">
                <MudStack Spacing="4">
                    <MudTextField T="string" @bind-Value="_input.DisplayName" Label="Client name" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Enter the client's name" MaxLength="256"
                                  HelperText="How the tenant appears in SecurePulse" />
                    <MudTextField T="string" @bind-Value="_input.PrimaryDomain" Label="Microsoft 365 domain" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Enter the client's domain" Validation="@(new Func<string?, string?>(ValidateDomain))"
                                  Placeholder="contoso.com" HelperText="Any verified domain, or the tenant's .onmicrosoft.com domain"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Language" />
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_input.PartnerName" Label="Managed by (optional)" Variant="Variant.Outlined"
                                          MaxLength="256" HelperText="MSP or partner; empty for a direct client" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="_input.Industry" Label="Industry" Variant="Variant.Outlined">
                                @foreach (var industry in OnboardingService.Industries)
                                {
                                    <MudSelectItem T="string" Value="@industry">@industry</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudForm>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-6">
                <MudButton Variant="Variant.Text" Href="tenants">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_valid || _busy || !Onboarding.IsConfigured)"
                           StartIcon="@Icons.Material.Rounded.Link" OnClick="CreateAsync">
                    @(_busy ? "Looking up tenant…" : "Create consent link")
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudStack Spacing="4">
            <MudPaper Class="sp-card pa-6" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-3">How it works</MudText>
                <ol class="sp-steps">
                    <li><span class="sp-step-dot">1</span><div><MudText Typo="Typo.body2" Style="font-weight:600">You create a consent link</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">We check the domain belongs to a Microsoft 365 tenant.</MudText></div></li>
                    <li><span class="sp-step-dot">2</span><div><MudText Typo="Typo.body2" Style="font-weight:600">The client's admin approves</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">A Global Administrator signs in to Microsoft and grants read-only access.</MudText></div></li>
                    <li><span class="sp-step-dot">3</span><div><MudText Typo="Typo.body2" Style="font-weight:600">SecurePulse verifies and scans</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">We confirm the access with Microsoft, then read the tenant's devices and run the security checks.</MudText></div></li>
                </ol>
            </MudPaper>

            <MudPaper Class="sp-card pa-6" Elevation="0" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Rounded.Visibility" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.h6">Read-only access</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    The admin approves these Microsoft Graph permissions. All are read-only: none can change anything in the tenant.
                </MudText>
                <MudExpansionPanels Elevation="0" Dense="true" Outlined="false">
                    @foreach (var group in AssessmentPermissions.Required.GroupBy(p => p.Group))
                    {
                        <MudExpansionPanel Text="@($"{group.Key} · {group.Count()} permissions")">
                            <MudStack Spacing="2">
                                @foreach (var p in group)
                                {
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight:600">@p.Purpose</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family:ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere">@p.Name</MudText>
                                    </div>
                                }
                            </MudStack>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    // Prefilled by the Re-consent action on a tenant card.
    [SupplyParameterFromQuery(Name = "name")] public string? PrefillName { get; set; }
    [SupplyParameterFromQuery(Name = "domain")] public string? PrefillDomain { get; set; }
    [SupplyParameterFromQuery(Name = "partner")] public string? PrefillPartner { get; set; }
    [SupplyParameterFromQuery(Name = "industry")] public string? PrefillIndustry { get; set; }

    protected override void OnInitialized()
    {
        _input.DisplayName ??= PrefillName;
        _input.PrimaryDomain ??= PrefillDomain;
        _input.PartnerName ??= PrefillPartner;
        if (PrefillIndustry is { } industry && OnboardingService.Industries.Contains(industry)) _input.Industry = industry;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A prefilled form starts untouched; validate so "Create consent link" is enabled.
        if (firstRender && _form is not null && PrefillDomain is not null)
        {
            await _form.Validate();
            StateHasChanged();
        }
    }

    private readonly ConnectTenantForm _input = new();
    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Tenants", href: "tenants"), new("Connect", href: null, disabled: true)];
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private string? _error;

    private static string? ValidateDomain(string? value) =>
        string.IsNullOrWhiteSpace(value) || OnboardingService.NormalizeDomain(value) is not null
            ? null
            : "Enter a domain like contoso.com";

    private async Task CreateAsync()
    {
        if (_form is not null) await _form.Validate();
        if (!_valid) return;

        _busy = true;
        _error = null;
        try
        {
            var result = await Onboarding.StartAsync(_input);
            if (result.Request is { } request)
                Nav.NavigateTo($"tenants/connect/{request.Id}{(result.Reused ? "?reused=true" : "")}");
            else
                _error = result.Error;
        }
        finally
        {
            _busy = false;
        }
    }
}
