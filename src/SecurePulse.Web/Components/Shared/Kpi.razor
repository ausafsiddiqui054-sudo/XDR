<MudPaper Class="sp-card sp-lift pa-5" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Label</MudText>
        <MudIcon Icon="@Icon" Color="@Color" />
    </MudStack>
    <div class="sp-kpi-value mt-3">@($"{Value}{Suffix}")</div>
    @if (Detail is not null)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@Detail</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public int Value { get; set; }
    [Parameter] public string? Suffix { get; set; }
    /// <summary>Optional small line under the value.</summary>
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Rounded.Insights;
    [Parameter] public Color Color { get; set; } = Color.Primary;
}
