<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ColorOf(Status)" data-testid="action-status">
    @(Status == DeviceActionStatus.Sent && SentLabel is not null ? SentLabel : DeviceActionRequestService.Label(Status))
</MudChip>

@code {
    [Parameter, EditorRequired] public DeviceActionStatus Status { get; set; }

    /// <summary>What "Sent" means here; device actions go to Intune, configuration fixes to Entra.</summary>
    [Parameter] public string? SentLabel { get; set; }

    private static Color ColorOf(DeviceActionStatus status) => status switch
    {
        DeviceActionStatus.PendingApproval => Color.Warning,
        DeviceActionStatus.Approved or DeviceActionStatus.Sending => Color.Info,
        DeviceActionStatus.Sent => Color.Success,
        DeviceActionStatus.Failed or DeviceActionStatus.Rejected => Color.Error,
        _ => Color.Default
    };
}
