@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage BrowserStorage

<MudThemeProvider @ref="_themeProvider" Theme="HasinixTheme.Theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="sp-workspace">
    @* The side panel carries the brand; when it is closed (or an overlay, on small screens) the top bar shows it instead. *@
    <MudAppBar Elevation="0" Class="@(_drawerOpen ? "sp-appbar" : "sp-appbar sp-appbar-collapsed")">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Toggle navigation" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <a href="/" class="sp-appbar-brand" aria-label="Hasinix overview">
            <BrandLogo ShowTagline="false" />
        </a>
        <span class="sp-header-context">Workspace <span>/</span> Microsoft 365 security</span>
        <MudSpacer />
        <span class="sp-header-label"><span class="sp-status-dot"></span> Security workspace</span>
        <MudIconButton Icon="@(_isDark ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                       Color="Color.Inherit" aria-label="Toggle dark mode"
                       OnClick="ToggleDarkModeAsync" />
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2" aria-label="Account">
                    <ActivatorContent>
                        <MudAvatar Color="Color.Primary" Size="Size.Small" Style="cursor:pointer">@Initials(context.User)</MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 pt-3 pb-2" style="min-width:240px">
                            <MudText Typo="Typo.body2" Style="font-weight:600">@(context.User.DisplayName() ?? "Signed in")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.User.SignInName()</MudText>
                            @if (context.User.PortalRole() is { } role)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="ml-0 mt-2">@Pages.Users.RoleLabel(role)</MudChip>
                            }
                        </div>
                        <MudDivider />
                        <div class="px-2 py-2"><SignOutButton FullWidth="true" /></div>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="@DrawerVariant.Responsive" Class="sp-sidebar">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="sp-main-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string Initials(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.DisplayName() ?? user.SignInName() ?? "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private bool _drawerOpen = true;

    // Dark mode: the viewer's own choice (kept in this browser), otherwise the operating system's setting.
    private const string DarkModeKey = "securepulse.dark-mode";
    private MudThemeProvider _themeProvider = default!;
    private bool _isDark;
    private bool _hasSavedChoice;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (await ReadSavedChoiceAsync() is { } saved)
        {
            _hasSavedChoice = true;
            _isDark = saved;
        }
        else
        {
            _isDark = await _themeProvider.GetSystemDarkModeAsync();
            await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChangedAsync);
        }
        StateHasChanged();
    }

    private Task OnSystemDarkModeChangedAsync(bool dark)
    {
        if (_hasSavedChoice) return Task.CompletedTask;
        _isDark = dark;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDark = !_isDark;
        _hasSavedChoice = true;
        try
        {
            await BrowserStorage.SetAsync(DarkModeKey, _isDark);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Only a display preference: the toggle still works for this visit.
        }
    }

    private async Task<bool?> ReadSavedChoiceAsync()
    {
        try
        {
            var result = await BrowserStorage.GetAsync<bool>(DarkModeKey);
            return result.Success ? result.Value : null;
        }
        catch (Exception ex) when (ex is System.Security.Cryptography.CryptographicException or JSException
                                       or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Storage blocked, or a value protected with keys this portal no longer has: follow the system setting.
            return null;
        }
    }
}
