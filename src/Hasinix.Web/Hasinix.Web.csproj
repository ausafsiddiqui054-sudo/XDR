<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>securepulse-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hasinix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.*" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
    <!-- Patched version of a Microsoft.Identity.Web dependency (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 in 10.0.10). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hasinix.Core\Hasinix.Core.csproj" />
    <ProjectReference Include="..\Hasinix.Data\Hasinix.Data.csproj" />
    <ProjectReference Include="..\Hasinix.Playbooks\Hasinix.Playbooks.csproj" />
    <ProjectReference Include="..\Hasinix.Reporting\Hasinix.Reporting.csproj" />
  </ItemGroup>

</Project>
