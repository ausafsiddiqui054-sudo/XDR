{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "SecurePulse": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "DeviceSync": {
    "Enabled": true,
    "Interval": "04:00:00",
    "RunOnStartup": true,
    "MaxParallelTenants": 2
  },
  "Onboarding": {
    "Enabled": true,
    "CertificateThumbprint": "",
    "PollInterval": "00:00:15",
    "VerificationWindow": "00:30:00"
  },
  "DeviceActions": {
    "Enabled": true,
    "PollInterval": "00:00:15",
    "StuckSendingAfter": "00:10:00"
  },
  "Remediation": {
    "AppClientId": "",
    "CertificateThumbprint": "",
    "SendTimeout": "00:01:00"
  },
  "Scans": {
    "Enabled": true,
    "Engines": [
      "Maester"
    ],
    "Interval": "1.00:00:00",
    "RetryFailedAfter": "02:00:00",
    "PollInterval": "00:01:00",
    "MaxParallelScans": 2,
    "StaleAfter": "00:45:00",
    "CheckPermissions": true
  },
  "Maester": {
    "PwshPath": "pwsh",
    "AppClientId": "",
    "TestsPath": "./maester-tests",
    "ModuleVersion": "",
    "Timeout": "00:20:00"
  },
  "ScubaGear": {
    "PowerShellPath": "powershell.exe",
    "AppClientId": "",
    "ModuleVersion": "",
    "OpaPath": "",
    "Timeout": "00:30:00"
  },
  "Intune": {
    "AppClientId": "",
    "GraphBaseUrl": "https://graph.microsoft.com",
    "AuthorityHost": "https://login.microsoftonline.com",
    "FetchComplianceSettings": true,
    "MaxConcurrentRequests": 4,
    "MaxRetries": 3,
    "Timeout": "00:10:00"
  }
}
